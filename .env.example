# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend API (AirDunia backend server)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000
NEXT_PUBLIC_MYPARTNER_URL=http://localhost:3002

# Admin portal — super admin emails (comma-separated)
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=admin@yourdomain.com

# Admin session secret — random 32+ character string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate-a-random-32-char-string-here

# Redis — used for login rate limiting (same Upstash instance as backend works fine,
# admin's counters use their own "admin-ratelimit:" key prefix)
REDIS_URL=redis://localhost:6379
